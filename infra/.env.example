# Copy to infra/.env and adjust as needed for local development.
# docker-compose.yml's defaults already match this file - it exists for
# documentation and for services run outside compose (e.g. backend-api via
# `npm run backend:dev` against a locally-running Postgres).

DATABASE_URL=postgresql://beaive:beaive_dev_password@localhost:5432/beaive
ML_SERVICE_URL=http://localhost:8000
PORT=3000
POSE_LANDMARKER_MODEL_PATH=./services/ml-service/.models/pose_landmarker_lite.task
