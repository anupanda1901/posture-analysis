// beAIve backend-api data model — Phase 0 / start-of-Phase-1 scaffolding.
// Event is append-only by service-layer convention (EventsService exposes no
// update/delete). DB-level REVOKE UPDATE/DELETE hardening is a named follow-up,
// not enforced here (see docs/adr and the implementation plan's deferred list).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                String   @id @default(uuid())
  subjectPseudoId   String
  protocolId        String
  protocolVersion   String
  deploymentContext String
  consentRecordId   String
  retentionPolicy   Json
  calibrationRef    String?
  // Feeds subject-specific scale calibration (the only TRD-approved method
  // implemented this phase - docs/adr/008-scale-calibration-scope.md). Set via
  // POST /sessions/:id/height before calling POST /sessions/:id/scale-calibration.
  subjectHeightMeters Float?
  state             String
  // Full XState persisted snapshot (actor.getPersistedSnapshot()), so the safety
  // FSM can be correctly rehydrated after a process restart via the officially
  // supported createActor(machine, { snapshot }) path - `state` alone is kept as
  // a denormalized, human-readable/queryable mirror of snapshot.value.
  safetySnapshot    Json?
  createdAt         DateTime @default(now())

  events Event[]

  @@index([subjectPseudoId])
}

model Event {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  type      String
  schemaId  String
  payload   Json
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// Session-independent by design (docs/consent-and-retention.md): a subject
// consents once and multiple sessions can reference the same consent record
// via Session.consentRecordId. Not stored as an Event (Event.sessionId is
// required, but consent logically precedes session creation).
model ConsentRecord {
  id                     String    @id @default(uuid())
  subjectPseudoId        String
  scopes                 Json
  grantedAt              DateTime  @default(now())
  revokedAt              DateTime?
  withdrawalRequestedAt  DateTime?

  @@index([subjectPseudoId])
}

model ProtocolVersion {
  id          String   @id @default(uuid())
  protocolKey String
  version     String
  definition  Json
  status      String
  createdAt   DateTime @default(now())

  @@unique([protocolKey, version])
}
