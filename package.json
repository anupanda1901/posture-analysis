{
  "name": "beaive-posturology-platform",
  "version": "0.0.0",
  "private": true,
  "description": "beAIve Spatial Posturology Platform - monorepo root (Phase 0 / start of Phase 1 scaffolding)",
  "workspaces": [
    "packages/schemas",
    "services/backend-api",
    "apps/clinician-web"
  ],
  "scripts": {
    "schemas:generate": "npm run generate --workspace packages/schemas",
    "schemas:check": "npm run generate:check --workspace packages/schemas",
    "backend:dev": "npm run start:dev --workspace services/backend-api",
    "backend:test": "npm run test --workspace services/backend-api",
    "web:dev": "npm run dev --workspace apps/clinician-web",
    "web:build": "npm run build --workspace apps/clinician-web",
    "web:test": "npm run test --workspace apps/clinician-web",
    "lint:claims": "bash scripts/lint-claims.sh"
  }
}
